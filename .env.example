# Required: MongoDB Atlas free-tier connection string
MONGODB_URI=

PORT=3000

# Retry policy: 3 retries after the first try = 4 attempts total. Delays: 2s, 4s, 8s
MAX_RETRIES=3
BASE_DELAY_MS=2000
REQUEST_TIMEOUT_MS=5000

# Worker
POLL_INTERVAL_MS=500
WORKER_CONCURRENCY=5
LOCK_TIMEOUT_MS=30000

# Per-destination-host token bucket: burst size and refill rate
RATE_LIMIT_BURST=5
RATE_LIMIT_PER_SEC=2

ALLOW_PRIVATE_TARGETS=true
